{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIntrospectingWorkingAgentRoleForCheatCheck",
      "Effect": "Allow",
      "Action": [
        "iam:ListRolePolicies",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::778858743114:role/AgentCore-agentcorecli-de-ApplicationAgentNumberGue-a3fudBNIqUJZ"
    },
    {
      "Sid": "AllowReadingMaxLoopsParam",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-west-2:778858743114:parameter/number-guessing-ai-agents/max_loops"
    },
    {
      "Sid": "AllowInvokingRuntimeEndpoints",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:InvokeAgentRuntimeForUser"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-west-2:778858743114:runtime/agentcorecli_number_guessing_working_agent-N2POfH4Wm9/runtime-endpoint/*",
        "arn:aws:bedrock-agentcore:us-west-2:778858743114:runtime/agentcorecli_number_guessing_inspector_agent-CmCCXb6GFY/runtime-endpoint/*"
      ]
    }
  ]
}
